<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
  <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion><UseWinUI>true</UseWinUI>
  <WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  <Platforms>x64</Platforms><PlatformTarget>x64</PlatformTarget><RuntimeIdentifier>win-x64</RuntimeIdentifier>
  <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  <AssemblyName>BridgeCrew.Launcher</AssemblyName><RootNamespace>BridgeCrew.Launcher</RootNamespace>
  <Version>0.2.3</Version><DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  <StartupObject>BridgeCrew.Launcher.Program</StartupObject><PublishTrimmed>false</PublishTrimmed>
 </PropertyGroup>
 <ItemGroup>
  <ProjectReference Include="../Core/BridgeCrew.Packs.csproj" />
  <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  <PackageReference Include="Velopack" Version="1.2.0" />
  <Content Update="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  <Content Update="Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
 </ItemGroup>
 <Target Name="CopyWinUIResources" AfterTargets="Publish">
  <ItemGroup><_WinUIResource Include="$(TargetDir)App.xbf;$(TargetDir)MainWindow.xbf;$(TargetDir)$(AssemblyName).pri" /></ItemGroup>
  <Copy SourceFiles="@(_WinUIResource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
 </Target>
</Project>
