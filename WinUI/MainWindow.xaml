<Window x:Class="BridgeCrew.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:packs="using:BridgeCrew.Packs">
 <Grid x:Name="Root" Loaded="RootLoaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Padding="16,0,140,0" Background="Transparent"><StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><Image Source="Assets/AppIcon.png" Width="28" Height="28" AutomationProperties.Name="Starfleet delta with spanner"/><TextBlock Text="Bridge Crew Mod Launcher" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}"/></StackPanel></Grid>
  <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" PaneDisplayMode="LeftCompact" IsPaneOpen="False" IsSettingsVisible="True" IsPaneToggleButtonVisible="True" OpenPaneLength="220" SelectionChanged="NavigationChanged">
   <NavigationView.MenuItems>
    <NavigationViewItem Content="Online" Icon="Contact" Tag="online"/>
    <NavigationViewItem Content="Find crew" Icon="People" Tag="crew" IsSelected="True"/>
    <NavigationViewItem Content="My packs" Icon="Library" Tag="packs"/>
   </NavigationView.MenuItems>
   <Grid Padding="28,12,28,24">
    <ScrollViewer x:Name="CrewPage" VerticalScrollBarVisibility="Auto"><Grid RowSpacing="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions><StackPanel Spacing="8"><TextBlock Text="Find your crew" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Text="Review a lobby’s mod pack before subscribing." Opacity="0.7" TextWrapping="Wrap"/></StackPanel><ComboBox x:Name="Edition" Grid.Column="1" Header="PC edition" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="EditionChanged"><ComboBoxItem Content="Meta PC" Tag="meta"/><ComboBoxItem Content="Steam PC" Tag="steam"/></ComboBox></Grid>
     <InfoBar x:Name="DirectoryInfo" Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational" Title="Online crews" Message="Sign in on the Online page to find players. Launcher rooms are connected; Bridge Crew game joining is still being tested."/>
     <Grid x:Name="CrewColumns" Grid.Row="2" ColumnSpacing="20" RowSpacing="16" Height="560"><Grid.ColumnDefinitions><ColumnDefinition x:Name="LobbyColumn" Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
      <Grid x:Name="LobbyPane" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <AutoSuggestBox x:Name="Search" PlaceholderText="Search lobby or host" QueryIcon="Find" TextChanged="SearchChanged"/>
       <ListView x:Name="Lobbies" Grid.Row="1" SelectionChanged="LobbyChanged" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate x:DataType="packs:LobbyAdvertisement"><StackPanel Padding="8,12" Spacing="6"><TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{x:Bind HostName}" Opacity="0.7"/><TextBlock Text="Review the crew’s mod pack" FontSize="12" Opacity="0.65"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
       <Button Grid.Row="2" Content="Refresh lobbies" HorizontalAlignment="Stretch" Click="RefreshClicked"/>
      </Grid>
      <Border x:Name="PackPane" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
       <Grid RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="10"><TextBlock x:Name="PackTitle" Text="Select a lobby" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/><TextBlock x:Name="PackDescription" Text="See which mods the crew is using." TextWrapping="Wrap" Opacity="0.75"/><TextBlock x:Name="PackSummary" FontSize="12" Opacity="0.65" TextWrapping="Wrap"/><ComboBox x:Name="BuildProfile" Header="Declared game build" Visibility="Collapsed" SelectionChanged="BuildProfileChanged"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="Mods"><ItemsControl.ItemTemplate><DataTemplate x:DataType="packs:PackMod"><StackPanel Spacing="8" Padding="0,12,0,16"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="16"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{x:Bind Version}" FontSize="12" Opacity="0.65"/><TextBlock Text="{x:Bind Author}" FontSize="12" Opacity="0.65"/></StackPanel><TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Opacity="0.8"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="12"><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="SubscribeButton" Content="Review &amp; subscribe" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="SubscribeClicked"/><Button x:Name="JoinButton" Content="Join launcher room" IsEnabled="False" Click="JoinClicked"/></StackPanel><HyperlinkButton x:Name="ExportButton" Content="Export pack manifest" IsEnabled="False" Click="ExportClicked" Padding="0"/><TextBlock Text="Subscribed files stay in the launcher’s cache. Joining a launcher room does not launch or modify Bridge Crew." TextWrapping="Wrap" FontSize="12" Opacity="0.65"/></StackPanel>
       </Grid>
      </Border>
     </Grid>
     <InfoBar x:Name="Status" Grid.Row="3" IsOpen="True" IsClosable="False" Severity="Informational" Message="Loading sample lobbies…"/>
    </Grid></ScrollViewer>
    <ScrollViewer x:Name="OnlinePage" Visibility="Collapsed"><StackPanel Spacing="20" MaxWidth="900" HorizontalAlignment="Stretch">
     <StackPanel Spacing="8"><TextBlock Text="Online" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Text="Sign in, share packs and gather your crew." Opacity="0.7"/><InfoBar x:Name="OnlineStatus" IsOpen="True" IsClosable="False" Title="Connect to the crew service" Message="Accounts and launcher rooms are separate from your Meta, Steam and Ubisoft accounts."/></StackPanel>
     <Border Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="12">
      <TextBlock Text="Crew account" FontWeight="SemiBold"/><TextBlock x:Name="AccountLabel" Text="Signed out"/><HyperlinkButton x:Name="ServicePrivacy" Content="Service information &amp; stored data" NavigateUri="https://kiddabob.co.uk/BridgeCrew/privacy.html" Padding="0"/>
      <StackPanel x:Name="AccountForm" Spacing="12"><TextBox x:Name="AccountUsername" Header="Username" MaxLength="32"/><Expander Header="Display name for a new account (optional)" HorizontalAlignment="Stretch"><TextBox x:Name="AccountDisplayName" Header="Display name" MaxLength="64"/></Expander><PasswordBox x:Name="AccountPassword" Header="Password" MaxLength="128"/>
      <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="SignInButton" Content="Sign in" Click="SignInClicked"/><Button x:Name="RegisterButton" Content="Create account" Click="RegisterClicked"/></StackPanel>
      <Expander Header="Recover an account" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><PasswordBox x:Name="RecoveryCode" Header="Recovery code"/><TextBlock Text="Enter your username and a new password above, then use your saved recovery code." TextWrapping="Wrap"/><Button Content="Recover account" Click="RecoverClicked"/></StackPanel></Expander></StackPanel><Button x:Name="SignOutButton" Content="Sign out" Click="SignOutClicked" Visibility="Collapsed"/><Expander Header="Service connection" HorizontalAlignment="Stretch"><TextBox x:Name="ServiceUrl" Header="Crew service" Text="https://kiddabob.co.uk/BridgeCrew/api/v1/"/></Expander>
      <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Refresh online data" Click="OnlineRefreshClicked"/><Button Content="Try sample lobbies" Click="UseSamplesClicked"/></StackPanel>
     </StackPanel></Border>
     <Border x:Name="ActiveRoomPanel" Visibility="Collapsed" Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="12">
      <TextBlock Text="Your launcher room" FontWeight="SemiBold"/><TextBlock x:Name="RoomSummary" TextWrapping="Wrap"/><ListView x:Name="RoomMembers" MaxHeight="180"/><TextBox x:Name="RoomInvite" Header="Invitation code" IsReadOnly="True"/>
      <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Ready" Click="RoomReadyClicked"/><Button Content="Not ready" Click="RoomNotReadyClicked"/><Button Content="Leave room" Click="LeaveRoomClicked"/></StackPanel><StackPanel x:Name="RoomHostControls" Orientation="Horizontal" Spacing="10"><Button Content="New invitation" Click="RotateRoomInviteClicked"/><Button Content="Remove selected crew" Click="RemoveCrewClicked"/></StackPanel><TextBlock Text="Ready confirms your launcher pack. Game connection is not active yet." TextWrapping="Wrap" Opacity="0.7"/>
     </StackPanel></Border>
     <Border Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="12">
      <TextBlock Text="Published packs" FontWeight="SemiBold"/><TextBlock Text="Select a pack to review it and host a launcher room. Store support and build compatibility are declared by its publisher." TextWrapping="Wrap" Opacity="0.7"/>
      <ListView x:Name="PublishedPacks" MaxHeight="240"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="8,10"/></DataTemplate></ListView.ItemTemplate></ListView>
      <TextBox x:Name="RoomName" Header="Your lobby name" MaxLength="120"/><ComboBox x:Name="RoomVisibility" Header="Who can find your room?" SelectedIndex="0"><ComboBoxItem Content="Public" Tag="public"/><ComboBoxItem Content="Friends" Tag="friends"/><ComboBoxItem Content="Invitation only" Tag="invite"/></ComboBox>
      <Button Content="Review pack &amp; host" Click="HostRoomClicked"/><TextBlock Text="Hosting uses the PC edition selected on Find crew. Up to four players can join." TextWrapping="Wrap" Opacity="0.7"/>
      <Button Content="Publish a pack folder" Click="PublishFolderClicked"/><TextBlock x:Name="PublisherStatus" Text="Publishing requires approval from the service owner. A pack folder contains manifest.json and a content folder with files named by SHA-256." TextWrapping="Wrap" Opacity="0.7"/>
     </StackPanel></Border>

     <Border Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="12">
      <TextBlock Text="Invitation" FontWeight="SemiBold"/><TextBox x:Name="InviteCode" Header="Paste a crew invitation code"/><Button Content="Find invited crew" Click="ResolveInviteClicked"/>
      <TextBlock Text="Friends" FontWeight="SemiBold"/><TextBox x:Name="FriendUsername" Header="Friend’s username" MaxLength="32"/><Button Content="Send friend request" Click="FriendRequestClicked"/>
      <ListView x:Name="FriendsList" MaxHeight="220"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="8,10"/></DataTemplate></ListView.ItemTemplate></ListView>
      <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Accept request" Click="AcceptFriendClicked"/><Button Content="Remove" Click="RemoveFriendClicked"/><Button Content="Block" Click="BlockFriendClicked"/></StackPanel>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>
    <Grid x:Name="PacksPage" Visibility="Collapsed" RowSpacing="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Spacing="8"><TextBlock Text="My packs" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Text="Subscriptions are pinned to an exact pack version and PC edition." Opacity="0.7"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12"><Button Content="Refresh" Click="RefreshPacksClicked"/><Button Content="Open pack folder" Click="OpenPacksClicked"/></StackPanel><ListView x:Name="Subscriptions" Grid.Row="2" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="8,12"/></DataTemplate></ListView.ItemTemplate></ListView></Grid>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed"><StackPanel Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
     <StackPanel Spacing="8"><TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock x:Name="VersionText" Opacity="0.7"/></StackPanel>
     <Border Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="12"><TextBlock Text="Appearance" FontWeight="SemiBold"/><ComboBox x:Name="Theme" Header="App theme" Width="220" SelectedIndex="0" SelectionChanged="ThemeChanged"><ComboBoxItem Content="Use Windows setting" Tag="system"/><ComboBoxItem Content="Light" Tag="light"/><ComboBoxItem Content="Dark" Tag="dark"/></ComboBox></StackPanel></Border>
     <Border Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="12"><TextBlock Text="App updates" FontWeight="SemiBold"/><TextBlock Text="Updates come from published GitHub releases. Download an update when convenient, then restart the launcher to apply it." TextWrapping="Wrap"/><TextBlock x:Name="UpdateStatus" Text="Ready to check for updates." TextWrapping="Wrap" Opacity="0.7"/><ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Visibility="Collapsed"/><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="CheckUpdateButton" Content="Check for updates" Click="CheckUpdateClicked"/><Button x:Name="DownloadUpdateButton" Content="Download update" IsEnabled="False" Click="DownloadUpdateClicked"/><Button x:Name="RestartUpdateButton" Content="Restart to update" IsEnabled="False" Click="RestartUpdateClicked"/></StackPanel><HyperlinkButton Content="GitHub repository &amp; downloads" NavigateUri="https://github.com/Kiddabob/BridgeCrewModLauncher" Padding="0"/></StackPanel></Border>
     <Border Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel Spacing="10"><TextBlock Text="Mod development tools" FontWeight="SemiBold"/><TextBlock Text="A separate SDK and tool-launching integration are planned after we qualify the individual mod types. No SDK is included in this release." TextWrapping="Wrap" Opacity="0.7"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
   </Grid>
  </NavigationView>
 </Grid>
</Window>
